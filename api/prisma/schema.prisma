generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  HANDOVER
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
  FAILED
}

model Campus {
  id          String        @id @default(uuid())
  name        String
  emailDomain String        @unique
  createdAt   DateTime      @default(now())
  users       User[]
  requests    HelpRequest[]
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  passwordHash   String
  name           String
  campusId       String
  campus         Campus        @relation(fields: [campusId], references: [id])
  createdAt      DateTime      @default(now())
  requests       HelpRequest[] @relation("Requester")
  helpedRequests HelpRequest[] @relation("Helper")
  availability   Availability?
}

model Availability {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id])
  isAvailable Boolean  @default(false)
  lat         Float?
  lng         Float?
  updatedAt   DateTime @updatedAt
}

model HelpRequest {
  id          String        @id @default(uuid())
  title       String
  description String?
  pickup      String
  pickupLat   Float?
  pickupLng   Float?
  dropoff     String
  reward      Int
  neededBy    DateTime?
  status      RequestStatus @default(REQUESTED)
  requesterId String
  requester   User          @relation("Requester", fields: [requesterId], references: [id])
  helperId    String?
  helper      User?         @relation("Helper", fields: [helperId], references: [id])
  acceptedAt  DateTime?
  handoverCode String?
  campusId    String
  campus      Campus        @relation(fields: [campusId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([campusId, status])
}